# --- AI providers (at least one enables AI naming/explanations) ---
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used as an alternative and as automatic fallback if OpenAI fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Force a preferred provider: "openai" or "gemini". Leave blank to auto-pick
# whichever key is present (OpenAI first, Gemini as fallback).
AI_PROVIDER=

# --- Server ---
PORT=4000

# --- Optional: GitHub OAuth import ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
FRONTEND_URL=http://localhost:5173
