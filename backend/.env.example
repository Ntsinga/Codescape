# --- AI providers (at least one enables AI naming/explanations) ---
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used as an alternative and as automatic fallback if OpenAI fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Force a preferred provider: "openai", "gemini", or "deepseek". Leave blank to
# auto-pick whichever key is present (with automatic fallback to the others).
AI_PROVIDER=

# --- Database (required) ---
# Postgres connection string, e.g. from Neon (https://neon.tech). All durable
# state (repos, graph, semantic tree, source file contents) lives here — the
# app has no local persistence, which matters on hosts with ephemeral disks
# (e.g. Render's free tier).
DATABASE_URL=

# --- Server ---
PORT=4000

# --- Auth (required) ---
# Clerk secret key, from https://dashboard.clerk.com -> your app -> API Keys.
# Every /api route except /health and /docs requires a signed-in Clerk user;
# this key is what the backend uses to verify their session/token server-side.
CLERK_SECRET_KEY=

# --- Optional: GitHub OAuth import ---
# Each user connects their OWN GitHub account; the resulting token is stored
# server-side keyed to their Clerk user id and is never exposed to other users.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
FRONTEND_URL=http://localhost:5173
