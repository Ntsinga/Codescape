# Clerk publishable key, from https://dashboard.clerk.com -> your app -> API Keys.
# Safe to expose in the browser (it's the public half of the key pair).
VITE_CLERK_PUBLISHABLE_KEY=

# In production, point this at the deployed backend origin (e.g. https://api.example.com).
# Left blank in dev: Vite's proxy (vite.config.ts) forwards /api to localhost:4000.
VITE_API_BASE=
